# Build / packaging output
release/*.ipk
release/*.sha256.txt
release/ipk-debug/
release/verify-ipk/

# Runtime artifacts copied off a router for debugging
/logs/
/info/
/responses/
/config.sh
*.lock

# Editor / OS noise
.DS_Store
Thumbs.db

# Local session tooling (SSH helpers, npm deps) kept out of the package repo
/tools/
node_modules/
package-lock.json

# AI/agent tooling directories (per-platform), not part of the package
/.agent/
/.agents/
/.claude/
/.codebuddy/
/.codex/
/.cursor/
/.dsh/
/.gemini/
/.opencode/
/.pi/
/.trae/
/.zcode/

# Trellis: keep only local-only subpaths out of git (the rest is tracked)
.trellis/.backup-*
.trellis/worktrees/
.trellis/.runtime/
.trellis/.cache/
.trellis/.developer
