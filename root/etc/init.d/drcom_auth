#!/bin/sh /etc/rc.common
# procd service for HSTC Dr.COM authentication.
#
# Renders /etc/config/drcom_auth into /usr/share/drcom-auth/config.sh and then
# runs check_network.sh on an interval. Extra commands expose the individual
# auth stages for the LuCI panel.

START=95
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="authorize authenticate ticket login overview cas_params cas_body cas_login cas_status cas_ensure cas_logout cas_clear_bad_credentials portal_status auth_trace public_key public_key_status accounts_list account_set_active account_upsert account_delete update_status update_check update_install update_schedule"
EXTRA_HELP="	authorize		Get the Dr.COM authorize URL only
	authenticate		Run all diagnostic authentication stages and verify connectivity
	ticket			Run the full Dr.COM login flow now
	login			Alias of ticket
	cas_params		Fetch and save the standalone CAS login parameters
	cas_body		Show the assembled CAS login POST body (url-encoded)
	cas_login		Perform a standalone CAS login (no Dr.COM)
	cas_status		Show saved CAS parameters and cookie status
	cas_ensure		CAS login only when the stored cookie is missing/expired
	cas_logout		Clear the local CAS session (cookie and params)
	cas_clear_bad_credentials	Clear the credential lockout marker
	portal_status		Query Dr.COM for the real authentication state
	auth_trace		Show the Dr.COM auth chain responses and headers
	public_key		Update the cached HSCAS RSA public key
	public_key_status	Show cached HSCAS RSA public key status"

APP_DIR="/usr/share/drcom-auth"
CONFIG_FILE="$APP_DIR/config.sh"
TEMPLATE_FILE="$APP_DIR/config.sh.template"

uci_get() {
	config_get "$1" main "$2" "$3"
}

# Escape a value for use inside a double-quoted shell assignment.
sed_escape() {
	printf "%s" "$1" | sed -e 's/[\\&|]/\\&/g'
}

# Resolve the active account. Accounts live as `config account '<name>'`
# sections; `main.active_account` names the one to use. Legacy single
# `main.username`/`main.password` are migrated on the fly so upgrades keep
# working. Echoes: "<account>\t<username>\t<password>\t<space-separated-ids>"
resolve_account() {
	local active username password ids

	config_load drcom_auth
	config_get active main active_account ""

	# Enumerate account sections.
	ids=""
	config_foreach _collect_account account

	# Migrate a legacy single account into an account section once.
	if [ -z "$ids" ]; then
		config_get username main username ""
		config_get password main password ""
		if [ -n "$username" ]; then
			uci -q set drcom_auth.acc1=account
			uci -q set drcom_auth.acc1.username="$username"
			uci -q set drcom_auth.acc1.password="$password"
			uci -q delete drcom_auth.main.username
			uci -q delete drcom_auth.main.password
			uci -q set drcom_auth.main.active_account='acc1'
			uci -q commit drcom_auth
			active=acc1
			ids=acc1
		fi
	fi

	[ -n "$active" ] || active=$(printf '%s' "$ids" | awk '{print $1}')
	[ -n "$active" ] || active=""

	config_get username "$active" username ""
	config_get password "$active" password ""

	printf '%s\t%s\t%s\t%s\n' "$active" "$username" "$password" "$ids"
}

_collect_account() {
	ids="${ids:+$ids }$1"
}

# Explicit accounts must name an existing account section, never an option or
# a path. Do not resolve/migrate the global account for diagnostic commands.
validate_cas_account() {
	case "$1" in
		''|*[!A-Za-z0-9_-]*)
			echo "CAS: invalid account id: $1" >&2
			return 1
			;;
	esac
	[ "$(uci -q get "drcom_auth.$1")" = "account" ] || {
		echo "CAS: no such account: $1" >&2
		return 1
	}
}

# Render the runtime config. Explicit accounts use an isolated output path;
# omitted arguments retain the global active-account behavior.
write_config() {
	local enabled wan_port drcom_server_ip hscas_url account username password
	local hscas_public_key_url mac_type user_agent ping_host account_ids ids
	local output_file="$CONFIG_FILE" response_dir="$APP_DIR/responses" explicit_account=""

	if [ "$#" -gt 0 ]; then
		explicit_account="$1"
		validate_cas_account "$explicit_account" || return 1
		output_file="${2:-$APP_DIR/info/accounts/$explicit_account/cas_config.sh}"
		response_dir="$APP_DIR/info/accounts/$explicit_account/responses"
	fi

	config_load drcom_auth
	uci_get enabled enabled 0
	uci_get wan_port wan_port eth1
	uci_get drcom_server_ip drcom_server_ip 192.168.2.34
	uci_get hscas_url hscas_url https://hscas.hstc.edu.cn
	# Accept either the base host or a full /cas/login URL; derive the public
	# key URL from the normalized base so both stay consistent.
	hscas_url=$(printf '%s' "$hscas_url" | sed -e 's#/*$##' -e 's#[?#].*$##' -e 's#/*$##' -e 's#/cas/login$##' -e 's#/cas$##' -e 's#/*$##')
	uci_get hscas_public_key_url hscas_public_key_url "$hscas_url/cas/jwt/publicKey"
	uci_get mac_type mac_type 2
	uci_get user_agent user_agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/85.0.4183.121 Safari/537.36"
	uci_get ping_host ping_host baidu.com

	if [ -n "$explicit_account" ]; then
		account="$explicit_account"
		config_get username "$account" username ""
		config_get password "$account" password ""
		ids=""
		config_foreach _collect_account account
		account_ids="$ids"
	else
		# Active account credentials (single resolution).
		account=$(resolve_account)
		account_ids=$(printf '%s' "$account" | cut -f4)
		username=$(printf '%s' "$account" | cut -f2)
		password=$(printf '%s' "$account" | cut -f3)
		account=$(printf '%s' "$account" | cut -f1)
	fi
	[ -n "$account" ] || account="default"
	# The account id is used as a path component; keep it safe.
	account=$(printf '%s' "$account" | tr -cd 'A-Za-z0-9_.-')
	[ -n "$account" ] || account="default"

	mkdir -p "$APP_DIR/logs" "$APP_DIR/info/accounts/$account" "$response_dir" "$(dirname "$output_file")" || return 1

	if ! (
	umask 077
	sed \
		-e "s|__SCRIPT_DIR__|$(sed_escape "$APP_DIR")|g" \
		-e "s|__RESPONSE_DIR__|$(sed_escape "$response_dir")|g" \
		-e "s|__ACCOUNT_ID__|$(sed_escape "$account")|g" \
		-e "s|__ACCOUNT_IDS__|$(sed_escape "$account_ids")|g" \
		-e "s|__USER_AGENT__|$(sed_escape "$user_agent")|g" \
		-e "s|__WAN_PORT__|$(sed_escape "$wan_port")|g" \
		-e "s|__DRCOM_SERVER_IP__|$(sed_escape "$drcom_server_ip")|g" \
		-e "s|__HSCAS_URL__|$(sed_escape "$hscas_url")|g" \
		-e "s|__HSCAS_PUBLIC_KEY_URL__|$(sed_escape "$hscas_public_key_url")|g" \
		-e "s|__MAC_TYPE__|$(sed_escape "$mac_type")|g" \
		-e "s|__USERNAME__|$(sed_escape "$username")|g" \
		-e "s|__PASSWORD__|$(sed_escape "$password")|g" \
		-e "s|__PING_HOST__|$(sed_escape "$ping_host")|g" \
		"$TEMPLATE_FILE" > "$output_file.tmp.$$" &&
		chmod 600 "$output_file.tmp.$$" &&
		mv "$output_file.tmp.$$" "$output_file"
	); then
		rm -f "$output_file.tmp.$$"
		return 1
	fi
}

start_service() {
	local enabled check_interval

	# Scheduled updates are independent of automatic authentication.
	update_schedule >/dev/null 2>&1
	config_load drcom_auth
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get check_interval main check_interval 60

	write_config

	procd_open_instance
	procd_set_param command /bin/sh -c "while true; do /bin/sh \"$APP_DIR/check_network.sh\"; sleep \"$check_interval\"; done"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger drcom_auth
}

update_status() {
	/bin/sh "$APP_DIR/update.sh" status
}

update_check() {
	/bin/sh "$APP_DIR/update.sh" check
}

update_install() {
	/bin/sh "$APP_DIR/update.sh" install
}

update_schedule() {
	/bin/sh "$APP_DIR/update.sh" schedule
}

authorize() {
	write_config
	/bin/sh "$APP_DIR/get_authorize_url.sh"
}

ticket() {
	run_auth ticket "$@"
}

login() {
	ticket "$@"
}

# One manual attempt uses one account/config even if another RPC switches the
# global account while its HTTP requests are in flight. The stages themselves
# are the same scripts exposed by the diagnostic buttons, not a second login.
run_auth() (
	local action="$1" account config_file stage_output authorize_uri rc
	umask 077
	shift
	[ "$#" -le 1 ] || { echo 'diagnosis=expected one account id'; return 1; }
	if [ "$#" -eq 1 ]; then
		account="$1"
	else
		account=$(resolve_account | cut -f1)
	fi
	validate_cas_account "$account" || return 1
	mkdir -p "$APP_DIR/info/accounts/$account" || return 1
	config_file=$(mktemp "$APP_DIR/info/accounts/$account/auth_config.XXXXXX") || return 1
	stage_output="$config_file.output"
	trap 'rm -f "$config_file" "$stage_output"' EXIT
	write_config "$account" "$config_file" || return 1
	export DRCOM_CONFIG_FILE="$config_file" DRCOM_CAS_CONFIG_FILE="$config_file"
	if [ "$action" = ticket ]; then
		/bin/sh "$APP_DIR/auto_login_and_verify.sh"
		return $?
	fi

	# Keep raw request bodies and cookies out of the one-click RPC response.
	# Only the failed stage and a known diagnosis are returned to the UI.
	auth_failure() {
		printf 'authenticated=0\nstage=%s\n' "$1"
		if grep -q '^diagnosis=bad_credentials$' "$stage_output"; then
			printf 'diagnosis=bad_credentials\n'
		else
			printf 'diagnosis=authentication failed\n'
		fi
		printf 'message=Authentication failed at %s. See Diagnostics for details.\n' "$1"
	}
	/bin/sh "$APP_DIR/cas_auth.sh" clear_bad_credentials > "$stage_output" 2>&1 || {
		rc=$?; auth_failure cas_login; return "$rc"
	}
	if authorize_uri=$(/bin/sh "$APP_DIR/get_authorize_url.sh" 2> "$stage_output") && [ -n "$authorize_uri" ]; then
		:
	else
		rc=$?; [ "$rc" -ne 0 ] || rc=1
		auth_failure authorize; return "$rc"
	fi
	/bin/sh "$APP_DIR/cas_auth.sh" params > "$stage_output" 2>&1 || {
		rc=$?; auth_failure cas_params; return "$rc"
	}
	# A success page has no form token. Reposting an old saved execution in
	# this case would turn an already authenticated CAS session into a failure.
	if ! grep -q '^diagnosis=already logged in$' "$stage_output"; then
		/bin/sh "$APP_DIR/cas_auth.sh" login > "$stage_output" 2>&1 || {
			rc=$?; auth_failure cas_login; return "$rc"
		}
	fi
	/bin/sh "$APP_DIR/auto_login_and_verify.sh" "$authorize_uri" > "$stage_output" 2>&1 || {
		rc=$?; auth_failure drcom; return "$rc"
	}
	/bin/sh "$APP_DIR/cas_auth.sh" portal_status > "$stage_output" 2>&1 || {
		rc=$?; auth_failure verify; return "$rc"
	}
	if ! grep -q '^portal=online$' "$stage_output"; then
		auth_failure verify
		return 1
	fi
	printf 'authenticated=1\nstage=complete\n'
	cat "$stage_output"
)

authenticate() {
	run_auth authenticate "$@"
}

# Keep diagnostic config immutable for the lifetime of this invocation. The
# subshell scopes cleanup and preserves the CAS command's exit status.
run_cas() (
	local command="$1" account config_file
	shift
	if [ "$#" -eq 0 ]; then
		write_config || return 1
		DRCOM_CAS_CONFIG_FILE="$CONFIG_FILE" /bin/sh "$APP_DIR/cas_auth.sh" "$command"
		return $?
	fi
	[ "$#" -eq 1 ] || { echo "CAS: expected one account id" >&2; return 1; }
	account="$1"
	validate_cas_account "$account" || return 1
	mkdir -p "$APP_DIR/info/accounts/$account" || return 1
	config_file=$(mktemp "$APP_DIR/info/accounts/$account/cas_config.XXXXXX") || return 1
	trap 'rm -f "$config_file"' EXIT
	write_config "$account" "$config_file" || return 1
	DRCOM_CAS_CONFIG_FILE="$config_file" /bin/sh "$APP_DIR/cas_auth.sh" "$command"
)

# Fetch the standalone CAS login page and save the session-bound parameters
# (execution / currentMenu / failN / _eventId). No Dr.COM involvement.
cas_params() {
	run_cas params "$@"
}

# Show the assembled CAS login POST body (password already RSA encrypted and
# every field url-encoded), for inspection and copy-paste.
cas_body() {
	run_cas body "$@"
}

# Perform a standalone CAS login and persist cookies under /usr/share/drcom-auth/info.
cas_login() {
	run_cas login "$@"
}

# Clear the credential lockout marker for the active account (manual connect).
cas_clear_bad_credentials() {
	run_cas clear_bad_credentials "$@"
}

# Report saved CAS parameters and cookie status.
cas_status() {
	run_cas status "$@"
}

# CAS login only when the stored cookie is missing or expired.
cas_ensure() {
	run_cas ensure "$@"
}

# Clear the local CAS session so params can be fetched fresh again.
cas_logout() {
	run_cas logout "$@"
}

# --- account management -----------------------------------------------------
# List accounts as one line each: <id><TAB><username><TAB><active|-> 
accounts_list() {
	local active ids id user

	resolve_account >/dev/null 2>&1
	active=$(uci -q get drcom_auth.main.active_account)
	ids=$(resolve_account | cut -f4)

	[ -n "$active" ] || active=$(printf '%s' "$ids" | awk '{print $1}')

	for id in $ids; do
		user=$(uci -q get "drcom_auth.$id.username")
		if [ "$id" = "$active" ]; then
			printf '%s\t%s\tactive\n' "$id" "$user"
		else
			printf '%s\t%s\t-\n' "$id" "$user"
		fi
	done
}

# Remove the credential lockout marker for an account so the automatic
# reconnect loop is allowed to try again. Used when an account is switched or
# edited, or when the user connects manually.
clear_account_bad_credentials() {
	local id="$1"
	[ -n "$id" ] || return 0
	rm -f "$APP_DIR/info/accounts/$id/bad_credentials" 2>/dev/null || true
}

# Select the active account (and render its config).
account_set_active() {
	local id="$1"
	[ -n "$id" ] || { echo "account_set_active: missing id" >&2; return 1; }
	uci -q get "drcom_auth.$id" >/dev/null 2>&1 || {
		echo "account_set_active: no such account: $id" >&2
		return 1
	}
	uci -q set "drcom_auth.main.active_account=$id"
	uci -q commit drcom_auth
	# Switching accounts is an explicit user action: allow the retry loop again.
	clear_account_bad_credentials "$id"
	write_config
	printf 'active=%s\n' "$id"
}

# Create or update an account: account_upsert <id> <username> [password]
account_upsert() {
	local id="$1" user="$2" pass="$3"
	[ -n "$id" ] && [ -n "$user" ] || {
		echo "account_upsert: usage: <id> <username> [password]" >&2
		return 1
	}
	[ -z "$(uci -q get drcom_auth.$id)" ] && uci -q set "drcom_auth.$id=account"
	uci -q set "drcom_auth.$id.username=$user"
	[ -n "$pass" ] && uci -q set "drcom_auth.$id.password=$pass"

	# First account becomes active automatically.
	if [ -z "$(uci -q get drcom_auth.main.active_account)" ]; then
		uci -q set "drcom_auth.main.active_account=$id"
	fi
	uci -q commit drcom_auth

	# Drop that account's cached session (including any credential lockout
	# marker) so a changed password starts clean.
	rm -rf "$APP_DIR/info/accounts/$id" 2>/dev/null || true

	write_config
	printf 'saved=%s\n' "$id"
}

# Delete an account and its cached state.
account_delete() {
	local id="$1" active first
	[ -n "$id" ] || { echo "account_delete: missing id" >&2; return 1; }

	uci -q delete "drcom_auth.$id"
	active=$(uci -q get drcom_auth.main.active_account)
	if [ "$active" = "$id" ]; then
		first=$(resolve_account | cut -f4 | awk '{print $1}')
		if [ -n "$first" ]; then
			uci -q set "drcom_auth.main.active_account=$first"
		else
			uci -q delete drcom_auth.main.active_account
		fi
	fi
	uci -q commit drcom_auth
	rm -rf "$APP_DIR/info/accounts/$id" 2>/dev/null || true

	write_config
	printf 'deleted=%s\n' "$id"
}

# Overall status for the panel's status card: network reachability and the
# Dr.COM-side auth result. CAS/cookie state comes from cas_status.
# Named overview because `status` is reserved by rc.common.
overview() {
	local ping_host net portal portal_out portal_uid

	write_config
	. "$CONFIG_FILE"

	ping_host="${PING_HOST:-baidu.com}"
	if ping -c 1 -W 2 "$ping_host" >/dev/null 2>&1; then
		net=up
	else
		net=down
	fi

	# Real Dr.COM state: the portal's own connectivity probe.
	portal_out=$(/bin/sh "$APP_DIR/cas_auth.sh" portal_status 2>/dev/null)
	portal=$(printf '%s\n' "$portal_out" | sed -n 's/^portal=//p')
	portal_uid=$(printf '%s\n' "$portal_out" | sed -n 's/^portal_uid=//p')
	[ -n "$portal" ] || portal=unknown

	printf 'network=%s\n' "$net"
	printf 'drcom=%s\n' "$portal"
	printf 'account=%s\n' "$portal_uid"
}

# Query the Dr.COM portal for the real authentication state.
portal_status() {
	write_config
	/bin/sh "$APP_DIR/cas_auth.sh" portal_status
}

# Dr.COM auth chain trace (responses + headers) for the Diagnostics panel.
auth_trace() {
	write_config
	/bin/sh "$APP_DIR/cas_auth.sh" auth_trace
}

public_key() {
	local tmp code

	write_config
	. "$CONFIG_FILE"
	mkdir -p "$COOKIE_DIR" "$(dirname "$PUBLIC_KEY_FILE")"
	tmp="$PUBLIC_KEY_FILE.tmp"

	code=$(curl -L -H "User-Agent: $USER_AGENT" -s -o "$tmp" -w "%{http_code}" "$HSCAS_PUBLIC_KEY_URL")
	if [ "$code" = "200" ] && grep -q "BEGIN PUBLIC KEY" "$tmp"; then
		mv "$tmp" "$PUBLIC_KEY_FILE"
		chmod 600 "$PUBLIC_KEY_FILE"
		public_key_status
		return 0
	fi

	rm -f "$tmp"
	printf "%s\n" "Update public key failed: $HSCAS_PUBLIC_KEY_URL (HTTP ${code:-unknown})" >&2
	return 1
}

public_key_status() {
	local mtime

	write_config
	. "$CONFIG_FILE"

	if [ ! -s "$PUBLIC_KEY_FILE" ]; then
		return 0
	fi

	mtime=$(stat -c "%y" "$PUBLIC_KEY_FILE" 2>/dev/null | sed 's/\..*//')
	[ -n "$mtime" ] || mtime=$(ls -l "$PUBLIC_KEY_FILE" 2>/dev/null | awk '{print $6" "$7" "$8}')
	printf "%s\t%s\t%s\n" "updated" "$mtime" "$PUBLIC_KEY_FILE"
}

boot() {
	start
}
