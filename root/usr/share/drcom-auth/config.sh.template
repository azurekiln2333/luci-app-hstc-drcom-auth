# Template for the runtime config rendered by /etc/init.d/drcom_auth.
# Do NOT edit this file directly: it is generated from /etc/config/drcom_auth.
#
# UCI option       -> shell variable
# ---------------     --------------
# wan_port          -> WAN_PORT
# username          -> USERNAME
# password          -> PASSWORD
# drcom_server_ip   -> DRCOM_SERVER_IP
# hscas_url         -> HSCAS_URL
# hscas_public_key_url -> HSCAS_PUBLIC_KEY_URL
# mac_type          -> MAC_TYPE           1 = PC, 2 = mobile
# check_interval    -> CHECK_INTERVAL
# ping_host         -> PING_HOST
# user_agent        -> USER_AGENT

SCRIPT_DIR="__SCRIPT_DIR__"

USER_AGENT="__USER_AGENT__"
WAN_PORT="__WAN_PORT__"
WAN_IP_ADDRESS=$(ifconfig "$WAN_PORT" 2>/dev/null | awk '/inet addr:/ { sub(/addr:/, "", $2); print $2; exit } /inet / { print $2; exit }')

DRCOM_SERVER_IP="__DRCOM_SERVER_IP__"
HSCAS_URL="__HSCAS_URL__"
VERIFY_URL="http://$DRCOM_SERVER_IP/"
HSCAS_PUBLIC_KEY_URL="__HSCAS_PUBLIC_KEY_URL__"
# Normalize the base URL so a setting like https://host/cas/login does not
# produce a doubled /cas/login/cas/login path. cas_auth.sh normalizes again on
# load, this keeps HSCAS_LOGIN_URL correct for anything sourcing config.sh.
HSCAS_BASE_URL=$(printf '%s' "$HSCAS_URL" | sed -e 's#/*$##' -e 's#[?#].*$##' -e 's#/*$##' -e 's#/cas/login$##' -e 's#/cas$##' -e 's#/*$##')
HSCAS_LOGIN_URL="$HSCAS_BASE_URL/cas/login"

EPORTAL_API="http://$DRCOM_SERVER_IP:801/eportal/portal"
AUTHORIZATION_API="$EPORTAL_API/cas/create"

LOGIN_METHOD="1"
TERM_IP="$WAN_IP_ADDRESS"
TERM_IPV6=""
TERM_MAC=$(cat "/sys/class/net/$WAN_PORT/address" 2>/dev/null | tr '[:lower:]' '[:upper:]')
WLAN_AC_IP="10.10.10.10"
WLAN_AC_NAME="AC001"
AUTHEX_ENABLE="1"
JS_VERSION="4.X"
MAC_TYPE="__MAC_TYPE__"

USERNAME="__USERNAME__"
PASSWORD="__PASSWORD__"

PING_HOST="__PING_HOST__"

LOG_DIR="$SCRIPT_DIR/logs"
LOG_FILE="$LOG_DIR/drcom_log.txt"
PING_LOG_FILE="$LOG_DIR/drcom_ping_log.txt"
STATUS_LOG_FILE="$LOG_DIR/drcom_status_log.txt"

# Active account. CAS state (cookies, params, login result) is per account so
# switching accounts never reuses another account's session.
ACCOUNT_ID="__ACCOUNT_ID__"
ACCOUNTS="__ACCOUNT_IDS__"

# Dr.COM-chain and CAS state is per account, but the CAS RSA public key is a
# single global value (same HSCAS_PUBLIC_KEY_URL for every account), so it is
# stored once under info/ and shared by all accounts.
COOKIE_DIR="$SCRIPT_DIR/info/accounts/$ACCOUNT_ID"
COOKIE_FILE="$COOKIE_DIR/cookie.txt"
HEADERS_FILE="$COOKIE_DIR/headers.txt"
# Global CAS public key (used by hscas_login.sh and cas_auth.sh).
PUBLIC_KEY_FILE="$SCRIPT_DIR/info/public_key.pem"
# Standalone CAS state (used by cas_auth.sh).
CAS_COOKIE_FILE="$COOKIE_DIR/cas_cookie.txt"
CAS_PARAMS_FILE="$COOKIE_DIR/cas_params.env"
# Lockout marker set when CAS rejects the credentials, so the automatic
# reconnect loop stops retrying (a locked account cannot log in at all).
BAD_CREDS_FILE="$COOKIE_DIR/bad_credentials"
CAS_PUBLIC_KEY_FILE="$SCRIPT_DIR/info/public_key.pem"
# Bundled fallback copy shipped with the package.
DEFAULT_PUBLIC_KEY_FILE="$SCRIPT_DIR/public_key.pem"

RESPONSE_DIR="__RESPONSE_DIR__"
POST_RESPONSE_CONTENT="$RESPONSE_DIR/post_response.html"
GET_RESPONSE_CONTENT="$RESPONSE_DIR/get_response.html"
THIRD_GET_RESPONSE_CONTENT="$RESPONSE_DIR/third_get_response.html"
CHECK_LOGIN_CONTENT="$RESPONSE_DIR/check_hotspot_content.html"
LOGIN_PAGE_CONTENT="$RESPONSE_DIR/login_page.html"

output_status() {
	local log_file="$1"
	local message="$2"
	mkdir -p "$(dirname "$log_file")"
	echo "$(date): $message" >> "$log_file"
	logger "drcom-auth: $message"
}

mkdir -p "$LOG_DIR" "$COOKIE_DIR" "$RESPONSE_DIR"

output_status "$LOG_FILE" "Current directory: $SCRIPT_DIR"
output_status "$LOG_FILE" "Current WAN PORT: $WAN_PORT"
output_status "$LOG_FILE" "Current WAN IP address: $WAN_IP_ADDRESS"
output_status "$LOG_FILE" "Current Username: $USERNAME"
